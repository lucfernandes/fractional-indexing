{
  "name": "lucfernandes/fractional-indexing",
  "description": "Fractional Indexing for PHP 7.1+",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Lucas Fernandes"
    }
  ],
  "require": {
    "php": ">=7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^7.5 || ^8.0 || ^9.0 || ^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "LucFernandes\\FractionalIndexing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LucFernandes\\FractionalIndexing\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "7.1.33"
    }
  }
}
